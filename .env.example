# Copia este archivo como .env y pon tu cadena de conexión real.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Opción 1: Supabase (botón "Connect" > "Session pooler")
# DATABASE_URL=postgresql://postgres.TU_REFERENCIA:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opción 2: Docker local
DATABASE_URL=postgresql://postgres:postgres_local@localhost:5432/itiid
